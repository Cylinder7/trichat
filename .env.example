# ==============================================
#  TriChat Bridge - configuration
#  1) Copy this file and rename the copy to:  .env
#  2) Fill in the values below
# ==============================================

# ---- Bridge hub ----
# Port the dashboard runs on (http://localhost:PORT)
PORT=3000

# A password that stops strangers from injecting chat.
# Make up your own and put the SAME one in the Roblox script!
BRIDGE_SECRET=change-me-to-something-random

# ---- Discord bot (see README, Step 2) ----
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# The channel the bridge talks in (right-click channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=

# ---- Minecraft bot (see README, Step 3) ----
# Address of YOUR Minecraft server
MC_HOST=localhost
MC_PORT=25565
# The username the bot joins with.
# If your server is in offline mode: any name works.
# If online mode: use a real Microsoft account name + set MC_PASSWORD.
MC_USERNAME=ChatBridgeBot
# MC_PASSWORD=only-needed-for-microsoft-accounts
# MC_VERSION=1.20.4   (uncomment to force a version; otherwise auto-detected)
